# ── Secrets ───────────────────────────────────────────────────────────────
.env
*.key
secrets.*

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ── Large result bundles & archives (generated, ~140 MB) ───────────────────
*.zip
archive*
results*

# ── Generated data caches ──────────────────────────────────────────────────
data/cache/

# ── Generated heavy outputs (kept on disk locally but never committed —
#    figures + the PDF report are release-asset material, not source.
#    The hero figure lives under docs/ instead.) ───────────────────────────
outputs/*.png
outputs/*.pdf
outputs/*.pptx
outputs/integration_master.csv
outputs/models/
logs/

# ── Presentation / deck artifacts (rebuilt from source, not commit-worthy) ──
*.pptx
*.docx

# ── Legacy notebook drafts (Kaggle-export duplicates, ~2.1 MB combined).
#    Final canonical notebooks live under notebooks/, exported from the
#    .py twins via scripts/_py_to_ipynb.py. ──────────────────────────────────
legacy/notebooks/

# ── Convenience copies of the Kaggle notebooks at the repo root (canonical
#    versions are tracked under notebooks/) ──────────────────────────────────
/kaggle_edge_and_multimodal.ipynb
/kaggle_fair_benchmark.ipynb
/kaggle_frontier_benchmark.ipynb
/FCPS_Report.pdf

# ── Notebook smoke-test artifacts (written to repo root by local validators) ──
frontier_benchmark.png
frontier_benchmark_metrics.json
edge_multimodal.png
edge_multimodal_results.json
fair_benchmark.png
fair_benchmark_results.json

# ── Local tooling / OS ──────────────────────────────────────────────────────
.claude/settings.local.json
.DS_Store
Thumbs.db
.venv/
venv/
*.log
